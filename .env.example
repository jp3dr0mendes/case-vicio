# Copie para .env (que NÃO é versionado) e ajuste. Valores abaixo são só para uso local.
POSTGRES_DB=vicio_case
POSTGRES_USER=vicio
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_PORT=5433

# UID/GID do dono de ./artifacts no host (Linux: rode `id -u` e `id -g`)
APP_UID=1000
APP_GID=1000

# ensemble: aplica a política sobre as saídas dos classificadores; baseline: só teste de contrato
CLASSIFICATION_MODE=ensemble
LOCAL_MODELS=qwen2.5:7b,llama3.1:8b

# Ollama: serviço do compose (perfil local-llm) ou nativo do host (recomendado no macOS: usa a GPU)
OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_IMAGE_TAG=latest
OLLAMA_PORT=11435
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_WORKERS=2
