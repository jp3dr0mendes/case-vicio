# Banco local para trilha de auditoria (somente desenvolvimento)
POSTGRES_DB=vicio_case
POSTGRES_USER=vicio
POSTGRES_PASSWORD=change_me_local_only
DATABASE_URL=postgresql://vicio:change_me_local_only@db:5432/vicio_case
APP_UID=1000
APP_GID=1000

# baseline: gera sugestões lexicais e envia tudo para revisão
# ollama: usa modelo local e verificação adicional antes de publicar
CLASSIFICATION_MODE=baseline
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_THREADS=2
TOP_K_CANDIDATES=12
PUBLISH_THRESHOLD=0.95
VERIFY_THRESHOLD=0.90
DATA_DIR=/app/data/input
ARTIFACTS_DIR=/app/artifacts
